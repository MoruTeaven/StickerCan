  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.js",
    "build:utools": "node build.js utools",
    "build:ztools": "node build.js ztools",
    "check": "node tools/check-changelog.js",
    "verify": "node tools/check-changelog.js && node build.js && node tools/smoke-test.js"
